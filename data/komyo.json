{
  "id": "komyo",
  "title": "光明真言",
  "fullTitle": "不空羂索毘盧遮那仏大灌頂光真言",
  "sources": [
    "https://www.koyasan-u.ac.jp/cms/wp-content/uploads/2025/03/250322_R7学生生活の手引き（奥之院参拝次第）.pdf",
