    },
    {
      "text": "度一切苦厄",
      "reading": "ど、いっさい、くやく。"
    },
    {
      "text": "舎利子",
      "reading": "しゃりし。"
    },
    {
      "text": "色不異空",
      "reading": "しき、ふいくう。"
    },
    {
      "text": "空不異色",
      "reading": "くう、ふいしき。"
    },
    {
      "text": "色即是空",
      "reading": "しきそく、ぜくう。"
    },
    {
      "text": "空即是色",
      "reading": "くうそく、ぜしき。"
    },
    {
      "text": "受想行識",
      "reading": "じゅ、そう、ぎょう、しき。"
    },
    {
      "text": "亦復如是",
      "reading": "やくぶ、にょぜ。"
    },
    {
      "text": "舎利子",
      "reading": "しゃりし。"
    },
    {
      "text": "是諸法空相",
      "reading": "ぜ、しょほう、くうそう。"
    },
    {
      "text": "不生不滅",
      "reading": "ふしょう、ふめつ。"
    },
    {
      "text": "不垢不浄",
      "reading": "ふく、ふじょう。"
    },
    {
      "text": "不増不減",
      "reading": "ふぞう、ふげん。"
    },
    {
      "text": "是故空中",
      "reading": "ぜこ、くうちゅう。"
    },
    {
      "text": "無色",
      "reading": "むしき。"
    },
    {
      "text": "無受想行識",
      "reading": "む、じゅ、そう、ぎょう、しき。"
    },
    {
      "text": "無眼耳鼻舌身意",
      "reading": "む、げん、に、び、ぜつ、しん、い。"
    },
    {
      "text": "無色声香味触法",
      "reading": "む、しき、しょう、こう、み、そく、ほう。"
    },
    {
      "text": "無眼界",
      "reading": "むげんかい。"
    },
    {
      "text": "乃至無意識界",
      "reading": "ないし、むいしきかい。"
    },
    {
      "text": "無無明",
      "reading": "むむみょう。"
    },
    {
      "text": "亦無無明尽",
      "reading": "やく、むむみょうじん。"
    },
    {
      "text": "乃至無老死",
      "reading": "ないし、むろうし。"
    },
    {
      "text": "亦無老死尽",
      "reading": "やく、むろうしじん。"
    },
    {
      "text": "無苦集滅道",
      "reading": "む、く、しゅう、めつ、どう。"
    },
    {
      "text": "無智亦無得",
      "reading": "むち、やくむとく。"
    },
    {
      "text": "以無所得故",
      "reading": "い、むしょとくこ。"
    },
    {
      "text": "菩提薩埵",
      "reading": "ぼだい、さった。"
    },
    {
      "text": "依般若波羅蜜多故",
      "reading": "え、はんにゃ、はらみったこ。"
    },
    {
      "text": "心無罣礙",
      "reading": "しん、むけいげ。"
    },
    {
      "text": "無罣礙故",
      "reading": "むけいげこ。"
    },
    {
      "text": "無有恐怖",
      "reading": "むう、くふ。"
    },
    {
      "text": "遠離一切顛倒夢想",
      "reading": "おんり、いっさい、てんどう、むそう。"
    },
    {
      "text": "究竟涅槃",
      "reading": "くきょう、ねはん。"
    },
    {
      "text": "三世諸仏",
      "reading": "さんぜ、しょぶつ。"
    },
    {
      "text": "依般若波羅蜜多故",
      "reading": "え、はんにゃ、はらみったこ。"
    },
    {
      "text": "得阿耨多羅三藐三菩提",
      "reading": "とく、あのくたら、さんみゃく、さんぼだい。"
    },
    {
      "text": "故知般若波羅蜜多",
      "reading": "こち、はんにゃ、はらみった。"
    },
    {
      "text": "是大神呪",
      "reading": "ぜ、だいじんしゅ。"
    },
    {
      "text": "是大明呪",
      "reading": "ぜ、だいみょうしゅ。"
    },
    {
      "text": "是無上呪",
      "reading": "ぜ、むじょうしゅ。"
    },
    {
      "text": "是無等等呪",
      "reading": "ぜ、むとうどうしゅ。"
    },
    {
      "text": "能除一切苦",
      "reading": "のうじょ、いっさいく。"
    },
    {
      "text": "真実不虚",
      "reading": "しんじつ、ふこ。"
    },
    {
      "text": "故説般若波羅蜜多呪",
      "reading": "こせつ、はんにゃ、はらみったしゅ。"
    },
    {
      "text": "即説呪曰",
      "reading": "そくせつ、しゅわつ。"
    },
    {
