[Unit]
Description=Midokoro offline summaries (serial, resumable)
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/app/midokoro-map/data/summary-work/import-manifest.json

[Service]
Type=simple
WorkingDirectory=%h/app/midokoro-map
ExecStartPre=/bin/sh %h/app/midokoro-map/scripts/build-summary-worker.sh
ExecStart=/usr/bin/python3 %h/app/midokoro-map/scripts/run-summary-work.py
Restart=on-failure
RestartSec=300
TimeoutStopSec=90
SuccessExitStatus=130
# A completed full audit exits 0 and leaves the worker stopped. No deployment
# or public-display change is triggered automatically.

[Install]
WantedBy=default.target
