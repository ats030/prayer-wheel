  "facts": [
    {
      "id": "yubatake-facts",
      "text": "湯畑の湯樋は湯の花を採るとともに、湯の温度を下げる役割を持つ。",
      "source_ids": [
        "source-1"
      ]
    },
    {
      "id": "netsunoyu-facts",
      "text": "草津の湯もみは、水を加えて湯を薄めずに温度を下げるための方法として伝えられている。熱乃湯で湯もみと草津の歌を紹介している。 湯もみには長さ180cmほどの板を使う。",
      "source_ids": [
        "source-2",
        "source-3"
      ]
    },
    {
      "id": "gozanoyu-facts",
      "text": "御座之湯は湯畑源泉と万代源泉という2種類の源泉を使用する。建物は江戸・明治時代の共同湯を思わせる姿で再建されたものである。",
      "source_ids": [
        "source-4"
      ]
    },
    {
      "id": "ohtakinoyu-facts",
      "text": "大滝乃湯は煮川源泉を使用する。合わせ湯では湯が浴槽を順に巡り、水を足さずに自然冷却する。",
      "source_ids": [
        "source-5"
      ]
    },
    {
      "id": "sainokawara-facts",
      "text": "西の河原露天風呂は森林に囲まれた露天風呂で、万代源泉を使用する。施設名から湯の出所を推定しない。",
      "source_ids": [
        "source-6"
      ]
    }
  ],
