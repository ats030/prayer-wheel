{
  "name": "ikimono-note-app-local-probe",
  "main": "src/worker.py",
  "base_dir": "src",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": false,
  "vars": {
    "IKIMONO_SYNTHETIC_AI": "1",
    "IKIMONO_SESSION_SECRET": "synthetic-local-app-probe-never-deploy",
    "IKIMONO_ALLOWED_HOSTS": "localhost,127.0.0.1",
    "IKIMONO_PUBLIC_ORIGIN": "http://localhost:8793"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ikimono-note-app-local-probe",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../cloudflare/migrations"
    }
  ]
}
