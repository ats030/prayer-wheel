{
  "name": "ikimono-note-preview",
  "main": "src/worker.py",
  "base_dir": "src",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "assets", "binding": "ASSETS", "run_worker_first": true},
  "vars": {
    "IKIMONO_ALLOWED_HOSTS": "ikimono-note-preview.ats030.workers.dev,localhost,127.0.0.1",
    "IKIMONO_PUBLIC_ORIGIN": "https://ikimono-note-preview.ats030.workers.dev"
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "ikimono-note-preview",
    "database_id": "779b52d2-66f6-4f29-8a4b-7f268fdc85d9",
    "migrations_dir": "../cloudflare/migrations"
  }]
}
