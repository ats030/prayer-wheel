{
  "name": "ikimono-note-backend",
  "main": "src/worker.py",
  "base_dir": "src",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": false},
  "build": {"command": "python3 build.py"},
  "rules": [{"type": "ESModule", "globs": ["**/*.mjs"]}],
  "assets": {"directory": "assets", "binding": "ASSETS", "run_worker_first": true},
  "vars": {
    "IKIMONO_LOGIN_REQUIRED": "1",
    "IKIMONO_PREVIEW_BASIC_REQUIRED": "0",
    "IKIMONO_BROWSER_GEMINI": "1",
    "IKIMONO_GBIF_FALLBACK": "1",
    "IKIMONO_ALLOWED_HOSTS": "ikimono-note.ats030.workers.dev",
    "IKIMONO_PUBLIC_ORIGIN": "https://ikimono-note.ats030.workers.dev"
  },
  "d1_databases": [{"binding": "DB", "database_name": "ikimono-note-production-candidate",
    "database_id": "35c18d62-4de8-4c50-96eb-14b7d3e9e6d5",
    "migrations_dir": "../cloudflare/migrations"}]
}
