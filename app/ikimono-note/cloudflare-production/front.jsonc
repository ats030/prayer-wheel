{
  "name": "ikimono-note",
  "main": "edge.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled": false},
  "build": {"command": "python3 build.py --front"},
  "services": [{"binding": "PYTHON", "service": "ikimono-note-backend"}],
  "vars": {
    "IKIMONO_LOGIN_REQUIRED": "1",
    "IKIMONO_PREVIEW_BASIC_REQUIRED": "0",
    "IKIMONO_JS_SESSION": "1",
    "IKIMONO_JS_GEMINI": "1",
    "IKIMONO_GBIF_FALLBACK": "1",
    "IKIMONO_ALLOWED_HOSTS": "ikimono-note.ats030.workers.dev",
    "IKIMONO_PUBLIC_ORIGIN": "https://ikimono-note.ats030.workers.dev",
    "IKIMONO_INDEXABLE_PATHS": "/login,/privacy,/terms,/changelog"
  },
  "d1_databases": [{"binding": "DB", "database_name": "ikimono-note-production-candidate",
    "database_id": "35c18d62-4de8-4c50-96eb-14b7d3e9e6d5"}]
}
