{
  "name": "timeline-generator",
  "main": "app-worker.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "app-assets",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/manage",
      "/manage/*",
      "/timelines/*",
      "/showa",
      "/showa/*"
    ]
  },
  "vpc_services": [
    {
      "binding": "PRIVATE_API",
      "service_id": "01a12f6a-0a27-79f2-a464-3d99ed7ec719"
    }
  ],
  "vars": {
    "ACCESS_ISSUER": "https://divine-boat-f31d.cloudflareaccess.com",
    "ACCESS_AUD": "61bcfba7565ecf6e10cdd6a1376628daf252a7110ba7abe26d2efdacac8ef474",
    "OWNER_EMAIL": "ats030@gmail.com"
  }
}
