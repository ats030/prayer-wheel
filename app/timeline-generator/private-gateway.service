[Unit]
Description=Timeline Generator private API gateway
After=network-online.target timeline-generator.service

[Service]
Type=simple
WorkingDirectory=%h/app/timeline-generator
Environment=TIMELINE_GATEWAY_TOKEN_FILE=%h/.config/timeline-generator/gateway.token
ExecStart=/usr/bin/python3 %h/app/timeline-generator/private_gateway.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
