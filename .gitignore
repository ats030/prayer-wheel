# 機密: 環境変数ファイルはコミットしない（APIキー・トークン等）
.env
.env.*
# .env.* に当たらない命名（ハイフン区切り）のバックアップも除外する
.env-backup-*/

# サービスのローカルチェックアウト（デプロイ先。それぞれ独自の .git を持つ）。
# 編集は pCloudDrive 側の作業コピーで行い、push してから app/deploy.sh <名前> で取り込む。
# 移行を増やしたらここに足すこと。app/rss-reader はこのリポジトリ自身が持つので対象外。
/app/writing/
/app/app-portal/
/app/calendar-viewer/
/app/web-clipper/
/app/image-editor/
/app/receipt-scanner/
/app/x-analyzer/
/app/x-post/
/app/memo/
/app/tool-inventory/
/app/onsen-map/

# アプリの設定 (APIキーが入る) と利用者のデータ。追跡されていないだけで無視は
# されておらず、git add -A 一発で入りうる状態だった。非公開リポジトリでも、
# 利用者のメールアドレスと課金される鍵を履歴に残す理由は無い。
/.config/*/settings.json
/.config/web-search-yacy/
/.config/web-search-opensearch/
/data/
/cache/

# Python のバイトコードキャッシュ (app/ 配下のアプリが生成する)
__pycache__/
*.pyc

# ホスト固有のsystemd drop-in (ats030-jxnu)。トポロジがホストごとに違う設定
# (例: evo-x2だけがローカルOllamaを別ポートで直結する) を git 同期対象に置くと
# 他ホストへそのまま適用され壊れる。host-local.conf という名前で分離する。
/.config/systemd/user/*.service.d/host-local.conf
