#!/bin/sh
# Deterministic Beads export shared by Claude, Codex, and OpenCode.
# The stock `bd hooks run pre-commit` uses BD_GIT_HOOK=1; with embedded Dolt 1.0.3
# it can export a stale snapshot and emits non-deterministic JSONL line order.
set -eu

if ! command -v bd >/dev/null 2>&1; then
  exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
jsonl="$repo_root/.beads/issues.jsonl"
raw="$repo_root/.beads/issues.jsonl.pre-commit.raw"
sorted="$repo_root/.beads/issues.jsonl.pre-commit.sorted"
trap 'rm -f "$raw" "$sorted"' EXIT HUP INT TERM

timeout_seconds=${BEADS_HOOK_TIMEOUT:-30}
if command -v timeout >/dev/null 2>&1; then
  timeout "$timeout_seconds" bd export -o "$raw"
else
  bd export -o "$raw"
fi
LC_ALL=C /usr/bin/sort -o "$sorted" "$raw"
cp -f "$sorted" "$jsonl"
git add -- "$jsonl"
