#!/bin/sh
# Deterministic Beads export shared by Claude, Codex, and OpenCode.
# The stock `bd hooks run pre-commit` uses BD_GIT_HOOK=1; with embedded Dolt 1.0.3
# it can export a stale snapshot and emits non-deterministic JSONL line order.
set -eu

if ! command -v bd >/dev/null 2>&1; then
  exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
jsonl="$repo_root/.beads/issues.jsonl"
raw="$repo_root/.beads/issues.jsonl.pre-commit.raw"
sorted="$repo_root/.beads/issues.jsonl.pre-commit.sorted"
trap 'rm -f "$raw" "$raw.head" "$sorted"' EXIT HUP INT TERM

timeout_seconds=${BEADS_HOOK_TIMEOUT:-30}
if command -v timeout >/dev/null 2>&1; then
  timeout "$timeout_seconds" bd export -o "$raw"
else
  bd export -o "$raw"
fi
LC_ALL=C /usr/bin/sort -o "$sorted" "$raw"

# A host whose Dolt DB missed `bd import` after a pull exports a subset and would
# silently drop committed issues (ats030-ikob). Refuse unless the drop is intended.
records='if ._type == "memory" then "memory:" + .key else "issue:" + .id end'
if [ "${BEADS_ALLOW_DROP:-0}" != 1 ] && git cat-file -e HEAD:.beads/issues.jsonl 2>/dev/null; then
  if ! command -v jq >/dev/null 2>&1; then
    echo >&2 "beads: jq is required to check the export; set BEADS_ALLOW_DROP=1 to skip"
    exit 1
  fi
  dropped=$(
    git show HEAD:.beads/issues.jsonl | jq -r "$records" | LC_ALL=C /usr/bin/sort -u > "$raw.head"
    jq -r "$records" "$sorted" | LC_ALL=C /usr/bin/sort -u | LC_ALL=C comm -23 "$raw.head" -
    rm -f "$raw.head"
  )
  if [ -n "$dropped" ]; then
    echo >&2 "beads: export lacks $(echo "$dropped" | wc -l) record(s) committed in HEAD, e.g.:"
    echo "$dropped" | head -5 >&2
    echo >&2 "beads: run 'bd import .beads/issues.jsonl' and scripts/bd-import-verify.py, then commit again."
    echo >&2 "beads: set BEADS_ALLOW_DROP=1 only for an intended bd delete."
    exit 1
  fi
fi
cp -f "$sorted" "$jsonl"
git add -- "$jsonl"
