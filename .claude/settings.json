{
  "cleanupPeriodDays": 365,
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/ats030/.local/bin/rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(bd *)",
            "command": "$HOME/.claude/hooks/beads-restore-reorder.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/warn-unpushed.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "grill-me@ai-workflow": true,
    "thinking-workflow@ai-workflow": true
  },
  "extraKnownMarketplaces": {
    "ai-workflow": {
      "source": {
        "source": "directory",
        "path": "/home/ats030/ai-workflow"
      }
    }
  },
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "language": "japanese"
}
