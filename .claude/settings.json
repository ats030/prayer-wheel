{
  "cleanupPeriodDays": 90,
  "env": {
    "SUPERPOWERS_DISABLE_TELEMETRY": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/ats030/.claude/hooks/rtk-hook-guard.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/ats030/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/warn-unpushed.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "grill-me@ai-workflow": true,
    "hallmark@ai-workflow": true,
    "thinking-workflow@ai-workflow": true
  },
  "extraKnownMarketplaces": {
    "ai-workflow": {
      "source": {
        "source": "directory",
        "path": "/home/ats030/ai-workflow"
      }
    }
  },
  "language": "japanese",
  "autoCompactWindow": 120000,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(bd:*)",
      "Bash(uv run:*)",
      "Bash(systemctl --user:*)",
      "Bash(./deploy-cloudrun.sh:*)",
      "Bash(/home/ats030/app/ikimono-note/deploy-cloudrun.sh:*)"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(bd dolt push:*)",
      "Bash(systemctl reboot:*)"
    ],
    "environment": [
      "**Scope**: Personal development under /home/ats030; follow the nearest AGENTS.md.",
      "**Secrets**: ~/.env and .env* files are sensitive and must never be committed or disclosed.",
      "**Remote boundaries**: Public uploads and changes to production-like targets require explicit confirmation.",
      "**Protected operations**: Treat IAM, networking, destructive system operations, and force pushes as sensitive.",
      "**Routine tools**: bd, uv, git, and user-level systemd are expected for in-scope local work."
    ]
  }
}
