{
  "cleanupPeriodDays": 365,
  "env": {
    "SUPERPOWERS_DISABLE_TELEMETRY": "1"
  },
  "model": "opus",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/beads-restore-reorder.sh",
            "if": "Bash(bd *)"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/ats030/.claude/hooks/rtk-hook-guard.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/ats030/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/warn-unpushed.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "grill-me@ai-workflow": true,
    "thinking-workflow@ai-workflow": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ai-workflow": {
      "source": {
        "source": "directory",
        "path": "/home/ats030/ai-workflow"
      }
    }
  },
  "language": "japanese",
  "theme": "dark",
  "agentPushNotifEnabled": true
}
