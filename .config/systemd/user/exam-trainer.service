[Unit]
Description=Exam Trainer (資格試験の練習問題, port 8522)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ats030
EnvironmentFile=-/home/ats030/.env
Environment=WEB_SEARCH_API_URL=http://127.0.0.1:8527
ExecStart=/home/ats030/app/exam-trainer.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=exam-trainer

[Install]
WantedBy=default.target
