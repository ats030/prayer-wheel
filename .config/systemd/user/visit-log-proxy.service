[Unit]
Description=visit-log 代理計測プロキシ (HTML編集不可のサードパーティアプリ向け)
After=network-online.target visit-log.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ats030
EnvironmentFile=-/home/ats030/.env
ExecStart=/usr/bin/python3 /home/ats030/app/visit-log-proxy/main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=visit-log-proxy

[Install]
WantedBy=default.target
