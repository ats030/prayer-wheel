[Unit]
Description=有孔ボードフック ジェネレータ (port 8521)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/ats030/app/pegboard-hook-generator.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pegboard-hook-generator

[Install]
WantedBy=default.target
