[Unit]
Description=X Analyzer (port 8503)
After=network-online.target home-ats030-pCloudDrive.mount
Requires=home-ats030-pCloudDrive.mount

[Service]
Type=simple
WorkingDirectory=/home/ats030
EnvironmentFile=-/home/ats030/.env
ExecStart=/home/ats030/app/x-analyzer.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=x-analyzer

[Install]
WantedBy=default.target
