[Unit]
Description=Sales Viewer (BOOTH/Cults3D 売上ビューア, port 8517)
After=network-online.target tailscaled.service home-ats030-pCloudDrive.mount
Wants=network-online.target
Requires=home-ats030-pCloudDrive.mount

[Service]
Type=simple
ExecStart=/home/ats030/app/sales-viewer.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sales-viewer

[Install]
WantedBy=default.target
