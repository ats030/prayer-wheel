[Unit]
Description=Rekimeshi Bot - 食の歴史X投稿生成サービス
# pCloudDrive(FUSE)マウント完了とネットワーク確立を待つ
After=network-online.target home-ats030-pCloudDrive.mount
Wants=network-online.target home-ats030-pCloudDrive.mount

[Service]
Type=oneshot
# 作業ディレクトリをプロジェクトルートに設定
WorkingDirectory=/home/ats030/pCloudDrive/Python/rekimeshi

# 環境変数は ~/.env に集約済み。ランナー内の load_dotenv が読むため
# EnvironmentFile は不要(systemdのパース差異・二重読込を避ける)

# exit 3 = 品質ゲートで投稿を出さなかった(設計どおりの結果であって障害ではない)。
# 分けていなかった頃は1週間に17回 status=1/FAILURE が記録され、本物の障害と
# 区別できなかった。障害通知を付けるとこれが混ざって通知が信用されなくなる。
SuccessExitStatus=3

# uv 専用venv (~/.venv/rekimeshi) 経由で投稿生成スクリプトを実行 (本番投稿)
ExecStart=/home/ats030/app/rekimeshi-bot.sh

# 標準出力とエラー出力をjournalctlで確認可能にする
StandardOutput=journal
StandardError=journal

# 失敗時の再起動設定（オプション）
# Restart=on-failure
# RestartSec=300

[Install]
WantedBy=default.target
