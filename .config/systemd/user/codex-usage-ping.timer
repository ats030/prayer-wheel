[Unit]
Description=Codex 使用率 ping のタイマー (実験, ats030-qxb3)

[Timer]
# primary窓は5時間あるので、手動でcodexを使っていればpingは無駄打ちにならない
# (既存データが新鮮ならスクリプト側がexit 3で即終了しクォータを消費しない)。
# 20分間隔にしているのは、窓が切れてから次にユーザーが見るまでの『不明』表示の
# 待ち時間を最大20分程度に抑えるため。
OnBootSec=5min
OnUnitActiveSec=20min
AccuracySec=1min

[Install]
WantedBy=timers.target
