[Unit]
Description=愛知県西部の警報をDiscordへ通知
After=network-online.target weather-viewer.service
Wants=network-online.target
ConditionHost=ubuntu-server-app
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/home/ats030
ExecStart=/usr/bin/python3 /home/ats030/app/weather_notify.py
TimeoutStartSec=90

