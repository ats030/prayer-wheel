[Unit]
Description=cognitive-stack health dashboard (read-only :8504)
After=network-online.target home-ats030-pCloudDrive.mount
Requires=home-ats030-pCloudDrive.mount

[Service]
Type=simple
WorkingDirectory=/home/ats030
EnvironmentFile=-/home/ats030/.env
ExecStart=/home/ats030/app/cognitive-stack-health.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cognitive-stack-health

[Install]
WantedBy=default.target
