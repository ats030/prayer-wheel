[Unit]
Description=visit-log - Cloud Run access log aggregates
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/ats030/google-cloud-sdk/bin/gcloud

[Service]
Type=oneshot
WorkingDirectory=/home/ats030
ExecStart=/home/ats030/.venv/bin/python /home/ats030/app/visit-log/fetch-cloud-run-logs.py
TimeoutStartSec=45min
UMask=0077
StandardOutput=journal
StandardError=journal
