[Unit]
Description=Receipt Scanner (レシート撮影→家計簿・経費・賞味期限, port 8519)
After=network-online.target home-ats030-pCloudDrive.mount
Requires=home-ats030-pCloudDrive.mount

[Service]
Type=simple
WorkingDirectory=/home/ats030
EnvironmentFile=-/home/ats030/.env
ExecStart=/home/ats030/app/receipt-scanner.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=receipt-scanner

[Install]
WantedBy=default.target
