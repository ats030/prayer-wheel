[Unit]
Description=Personal historical timeline (port 8532)
After=network-online.target ollama-openwebui-proxy.service

[Service]
Type=simple
WorkingDirectory=/home/ats030/app/history-timeline
Environment=TIMELINE_HOST=100.94.207.13
Environment=TIMELINE_PORT=8532
ExecStart=/usr/bin/python3 /home/ats030/app/history-timeline/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
