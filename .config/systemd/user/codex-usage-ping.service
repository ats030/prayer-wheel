[Unit]
Description=usage-viewer の Codex 使用率タイルを新鮮に保つ ping (実験, ats030-qxb3)

[Service]
Type=oneshot
# exit 3 = 既存データがまだ新鮮なので何もしなかった (設計どおり)。
SuccessExitStatus=3
WorkingDirectory=/home/ats030
ExecStart=/usr/bin/env /home/ats030/.local/bin/uv run python /home/ats030/app/codex-usage-ping.py
# 実測: codex exec 1本は数秒〜十数秒で完了する。スクリプト内タイムアウト
# (170秒) より少し余裕を持たせる。
TimeoutStartSec=210
StandardOutput=journal
StandardError=journal
SyslogIdentifier=codex-usage-ping

[Install]
WantedBy=default.target
