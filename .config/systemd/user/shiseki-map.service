[Unit]
Description=Shiseki Map (史跡マップ, port 8530)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ats030/app/shiseki-map
ExecStart=/home/ats030/app/shiseki-map.sh
Restart=on-failure
RestartSec=30
SuccessExitStatus=143

[Install]
WantedBy=default.target
