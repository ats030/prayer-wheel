[Unit]
Description=Tool Inventory (自作アプリ横断ツール一覧, port 8518)
After=network-online.target tailscaled.service home-ats030-pCloudDrive.mount
Wants=network-online.target
Requires=home-ats030-pCloudDrive.mount

[Service]
Type=simple
ExecStart=/home/ats030/app/tool-inventory.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tool-inventory

[Install]
WantedBy=default.target
