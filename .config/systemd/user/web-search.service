[Unit]
Description=Shared Web Search API (port 8527)
After=network-online.target tailscaled.service

[Service]
Type=simple
WorkingDirectory=/home/ats030/app/web-search
EnvironmentFile=-/home/ats030/.env
ExecStart=/home/ats030/.venv/bin/python serve.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
