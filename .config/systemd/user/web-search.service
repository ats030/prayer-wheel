[Unit]
Description=Shared Web Search API (port 8527)
After=network-online.target
# 上流の YaCy / SearXNG / OpenSearch は evo-x2 にしかない。ubuntu-server-app では
# 8527 を omatsuri-map (git 管理外のユニット) が使っており、起動すると衝突する (ats030-nxi0f)。
ConditionHost=evo-x2

[Service]
Type=simple
WorkingDirectory=/home/ats030/app/web-search
EnvironmentFile=-/home/ats030/.env
ExecStart=/home/ats030/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8527
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
