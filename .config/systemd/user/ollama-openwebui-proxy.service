[Unit]
Description=Local Ollama-compatible proxy to Open WebUI
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ats030
EnvironmentFile=-/home/ats030/.env
ExecStart=/usr/bin/python3 /home/ats030/app/ollama-openwebui-proxy.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ollama-proxy

[Install]
WantedBy=default.target
