[Unit]
Description=Gathering Information Scheduler (follow mode)
After=network-online.target home-ats030-pCloudDrive.mount gathering-information.service
Requires=home-ats030-pCloudDrive.mount

[Service]
Type=simple
WorkingDirectory=/home/ats030
EnvironmentFile=-/home/ats030/.env
ExecStart=/home/ats030/app/gathering-information-scheduler.sh
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gathering-information-scheduler

[Install]
WantedBy=default.target
