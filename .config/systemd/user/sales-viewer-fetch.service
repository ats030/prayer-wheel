[Unit]
Description=sales-viewer - BOOTH売上CSV自動取得
After=network-online.target home-ats030-pCloudDrive.mount
Wants=network-online.target home-ats030-pCloudDrive.mount

[Service]
Type=oneshot
# .env はランナー内の load_dotenv が読み込むため EnvironmentFile は使わない
WorkingDirectory=/home/ats030/pCloudDrive/Python/sales-viewer
ExecStart=/home/ats030/app/sales-viewer-fetch.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sales-viewer-fetch

[Install]
WantedBy=default.target
