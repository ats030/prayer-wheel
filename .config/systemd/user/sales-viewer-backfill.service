[Unit]
Description=sales-viewer - BOOTH売上CSV過去分バックフィル(一時的、完了したら削除可)
After=network-online.target home-ats030-pCloudDrive.mount
Wants=network-online.target home-ats030-pCloudDrive.mount

[Service]
Type=oneshot
# .env はランナー内の load_dotenv が読み込むため EnvironmentFile は使わない
WorkingDirectory=/home/ats030/app/sales-viewer
ExecStart=/home/ats030/app/sales-viewer-backfill.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sales-viewer-backfill

[Install]
WantedBy=default.target
