[Unit]
Description=opencode の既定 ollama モデルを保つタイマー

[Timer]
# keep_alive=-1 は無期限だが、その後に普通の推論要求が1回来ると既定の5分 TTL に
# 戻る (2026-08-22 実測: expires が 2318年 から 5分後に変わる)。つまり opencode が
# 使うたびにピンが外れ、5分放置でアンロードされ、次の要求が52GBの再ロード待ち
# (実測 約2分) になる。15分間隔ではこの谷を埋められなかった。
#
# 2分間隔なら TTL 5分より短いので、ピンが外れても落ちる前に貼り直せる。叩く中身は
# /api/ps の確認だけで、固定済みなら何もしない (ollama-keepalive.py)。
OnBootSec=2min
OnUnitActiveSec=2min
AccuracySec=30s

[Install]
WantedBy=timers.target
