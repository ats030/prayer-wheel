[Unit]
Description=Daily Reflection auto report (previous day)
After=network-online.target home-ats030-pCloudDrive.mount
Requires=home-ats030-pCloudDrive.mount

[Service]
Type=oneshot
WorkingDirectory=/home/ats030/pCloudDrive/Python/daily-reflection
EnvironmentFile=-/home/ats030/.env
# 当機はTZ=UTC。ログの日付境界を日本時間に合わせる。
Environment=TZ=Asia/Tokyo
ExecStart=/home/ats030/.venv/bin/python /home/ats030/pCloudDrive/Python/daily-reflection/auto_generate.py
# 生成900秒 × 3回 + 再試行待ち120秒 を収める
TimeoutStartSec=3600
StandardOutput=journal
StandardError=journal
SyslogIdentifier=daily-reflection-auto
