[Unit]
Description=Daily Reflection auto report (previous day)
After=network-online.target

[Service]
Type=oneshot
# 3 = 品質ゲートで成果物を出さなかった (設計どおり)。障害 (1) と分ける。
# 143 は SIGTERM で、failure-policy.conf 側が受け持つ (併記でマージされる)。
SuccessExitStatus=3
WorkingDirectory=/home/ats030/data/daily-reflection
EnvironmentFile=-/home/ats030/.env
# 当機はTZ=UTC。ログの日付境界を日本時間に合わせる。
Environment=TZ=Asia/Tokyo
# bd は既定PATHに無く、cwd からの探索でもDBに辿り着かないため明示する。
Environment=BEADS_DIR=/home/ats030/.beads
ExecStart=/home/ats030/.venv/bin/python /home/ats030/data/daily-reflection/auto_generate.py
# 生成900秒 × 3回 + 再試行待ち120秒 を収める
TimeoutStartSec=3600
StandardOutput=journal
StandardError=journal
SyslogIdentifier=daily-reflection-auto
