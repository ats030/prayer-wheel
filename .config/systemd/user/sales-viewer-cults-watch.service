[Unit]
Description=sales-viewer - Cults3D売上CSV自動取込み(Downloadsフォルダ監視)
After=network-online.target home-ats030-pCloudDrive.mount
Wants=network-online.target home-ats030-pCloudDrive.mount

[Service]
Type=oneshot
WorkingDirectory=/home/ats030/app/sales-viewer
ExecStart=/home/ats030/app/sales-viewer-cults-watch.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sales-viewer-cults-watch

[Install]
WantedBy=default.target
