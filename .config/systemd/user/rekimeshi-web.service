[Unit]
Description=rekimeshi Web UI (閲覧・設定, port 8514)
After=network-online.target home-ats030-pCloudDrive.mount
Requires=home-ats030-pCloudDrive.mount

[Service]
Type=simple
WorkingDirectory=/home/ats030
ExecStart=/home/ats030/app/rekimeshi-web.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rekimeshi-web

[Install]
WantedBy=default.target
