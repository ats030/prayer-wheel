[Unit]
Description=Daily Reflection auto report timer (00:00 JST)

[Timer]
# 当機はTZ=UTCのため Asia/Tokyo を明示。
# 06:00へのシフト実験(ats030-xe48)は3/7失敗(うち2件はqwen3-coder-nextの
# 無期限VRAM占有が06:00でも再現)で基準未達が確定したため0:00へ差し戻す。
# 恒久対策はプロキシ側GPU調停(discovered-from ats030-xe48)で別途対応する。
OnCalendar=*-*-* 00:00:00 Asia/Tokyo

# 停止中に発火時刻を過ぎた場合は起動後に実行
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
