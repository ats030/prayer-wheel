[Unit]
Description=Daily Reflection auto report timer (06:00 JST)

[Timer]
# 当機はTZ=UTCのため Asia/Tokyo を明示。GPUを共有する opencode と
# 重なりやすい0:00を避け、日本時間の6:00に発火させる (ats030-xe48)。
OnCalendar=*-*-* 06:00:00 Asia/Tokyo

# 停止中に発火時刻を過ぎた場合は起動後に実行
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
