[Unit]
Description=visit-log - Cloud Run公式リクエスト数取得
After=network-online.target
Wants=network-online.target
# gcloud と認証は ubuntu-server-app にしか無い。両ホストで取ると二重計上にもなる (ats030-x007l)。
ConditionPathExists=/home/ats030/google-cloud-sdk/bin/gcloud

[Service]
Type=oneshot
WorkingDirectory=/home/ats030
ExecStart=/home/ats030/.venv/bin/python /home/ats030/app/visit-log/fetch-cloud-run-stats.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=visit-log-cloud-stats
