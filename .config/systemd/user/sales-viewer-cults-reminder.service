[Unit]
Description=sales-viewer - Cults3D売上CSVの月次ダウンロード通知
After=network-online.target
Wants=network-online.target
# 月次の通知なので、両ホストで動くと同じ通知が2通届く。主ホストだけで動かす (ats030-x007l)。
ConditionHost=ubuntu-server-app

[Service]
Type=oneshot
WorkingDirectory=/home/ats030/app/sales-viewer
ExecStart=/home/ats030/app/sales-viewer-cults-reminder.sh
# 3 = Webhook未設定で送らなかった（設計どおり）
SuccessExitStatus=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sales-viewer-cults-reminder
