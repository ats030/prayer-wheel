[Unit]
Description=Weather Viewer (気象庁+Open-Meteo オープンデータ天気予報, port 8520)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ats030
EnvironmentFile=-/home/ats030/.env
ExecStart=/home/ats030/app/weather-viewer.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=weather-viewer

[Install]
WantedBy=default.target
