[Unit]
Description=Daily Reflection (port 8507)
After=network-online.target
# 日報の資料と出力は ~/data/daily-reflection (別リポジトリ) にあり、ubuntu-server-app にしか無い。
# 無いホストでは 200/CHDIR で failed になるので、起動自体を見送る (ats030-x007l)。
ConditionPathIsDirectory=/home/ats030/data/daily-reflection

[Service]
Type=simple
WorkingDirectory=/home/ats030/data/daily-reflection
EnvironmentFile=-/home/ats030/.env
# 当機はTZ=UTC。ブラウザ(JST)が送る日付と抽出の日付境界を揃える。
Environment=TZ=Asia/Tokyo
# bd は既定PATHに無く、cwd からの探索でもDBに辿り着かないため明示する。
Environment=BEADS_DIR=/home/ats030/.beads
ExecStart=/bin/sh /home/ats030/data/daily-reflection/run.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=daily-reflection

[Install]
WantedBy=default.target
