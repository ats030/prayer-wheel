[Unit]
Description=前日の日報の「次にやること」と RSS の急増語を Discord へ送る (ats030-2mn2i)
# 停止明けに Persistent で 00:00 の日報生成と同時に追いつくと、日報より先に走って
# 「日報なし」を送る。順序だけ付け、起動はさせない (Wants は付けない)
After=network-online.target daily-reflection-auto.service
Wants=network-online.target
# unit と timers.target.wants は git で evo-x2 にも配られる。日報も feed_cache も
# このホストにしか無く、両方で動くと二重に届く
ConditionHost=ubuntu-server-app

[Service]
Type=oneshot
# exit 3 = 日報も24時間以内の RSS も無い。障害の 1 と分ける
SuccessExitStatus=3
WorkingDirectory=/home/ats030
ExecStart=/usr/bin/python3 /home/ats030/app/morning-digest.py
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
SyslogIdentifier=morning-digest

# [Install] は置かない。timer からだけ起動する。enable すると起動のたびに送って
# 測定用の記録を上書きする
