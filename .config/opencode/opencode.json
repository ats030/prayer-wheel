{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3-coder-next:q4_K_M",
  "small_model": "ollama/qwen3-coder-next:q4_K_M",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "timeout": 1200000,
        "chunkTimeout": 300000
      },
      "models": {
        "gemma4:31b": {
          "name": "Gemma 4 31B (96k)",
          "limit": {
            "context": 98304,
            "input": 98304,
            "output": 8192
          }
        },
        "qwen3.8:27b": {
          "name": "Qwen 3.8 27B (64k)",
          "limit": {
            "context": 65536,
            "input": 65536,
            "output": 8192
          }
        },
        "qwen3-coder-next:q4_K_M": {
          "name": "Qwen3 Coder Next 80B Q4_K_M (64k)",
          "limit": {
            "context": 65536,
            "input": 65536,
            "output": 8192
          }
        },
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B Q4_K_M (64k)",
          "limit": {
            "context": 65536,
            "input": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "instructions": [
    "/home/ats030/AGENTS.md",
    "/home/ats030/.config/opencode/japanese-response.md"
  ],
  "skills": {
    "paths": [
      "/home/ats030/ai-workflow/plugins/grill-me/skills",
      "/home/ats030/ai-workflow/plugins/thinking-workflow/skills",
      "/home/ats030/ai-workflow/plugins/hallmark/skills"
    ]
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 16384,
    "preserve_recent_tokens": 16000,
    "tail_turns": 6
  },
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 24000
  },
  "agent": {
    "build": {
      "temperature": 0.2
    },
    "plan": {
      "temperature": 0.1
    }
  }
}
