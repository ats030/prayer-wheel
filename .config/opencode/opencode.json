{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.8:27b",
  "small_model": "ollama/qwen3.8:27b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "timeout": 600000,
        "chunkTimeout": 120000
      },
      "models": {
        "qwen3.8:27b": {
          "name": "Qwen 3.8 27B (64k)",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        },
        "qwen3-coder-next:latest": {
          "name": "Qwen3 Coder Next 80B (16k)",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },
  "instructions": [
    "/home/ats030/AGENTS.md"
  ],
  "skills": {
    "paths": [
      "/home/ats030/ai-workflow/plugins/grill-me/skills",
      "/home/ats030/ai-workflow/plugins/thinking-workflow/skills",
      "/home/ats030/ai-workflow/plugins/hallmark/skills"
    ]
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 4096
  },
  "agent": {
    "build": {
      "steps": 30,
      "temperature": 0.2
    }
  }
}
