{
  "$schema": "https://opencode.ai/config.json",
  "version": 1,
  "model": "ollama/qwen3-coder-next:q4_K_M",
  "small_model": "ollama/qwen3-coder-next:q4_K_M",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "timeout": 600000,
        "chunkTimeout": 300000
      },
      "models": {
        "gemma4:31b": {
          "name": "Gemma 4 31B (96k)",
          "limit": {
            "context": 98304,
            "input": 98304,
            "output": 8192
          }
        },
        "qwen3.8:27b": {
          "name": "Qwen 3.8 27B (64k)",
          "limit": {
            "context": 65536,
            "input": 65536,
            "output": 8192
          }
        },
        "qwen3-coder-next:q4_K_M": {
          "name": "Qwen3 Coder Next 80B Q4_K_M (64k)",
          "limit": {
            "context": 65536,
            "input": 65536,
            "output": 8192
          }
        },
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B Q4_K_M (64k)",
          "limit": {
            "context": 65536,
            "input": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "instructions": [
    "/home/ats030/AGENTS.md",
    "/home/ats030/.config/opencode/japanese-response.md"
  ],
  "skills": {
    "paths": [
      "/home/ats030/ai-workflow/plugins/grill-me/skills",
      "/home/ats030/ai-workflow/plugins/thinking-workflow/skills",
      "/home/ats030/ai-workflow/plugins/hallmark/skills"
    ]
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8192,
    "preserve_recent_tokens": 28000,
    "tail_turns": 6
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8000
  },
  "agent": {
    "build": {
      "temperature": 0.2,
      "steps": 30
    },
    "plan": {
      "temperature": 0.1
    },
    "compaction": {
      "temperature": 0.1,
      "prompt": "これまでの会話を、作業を中断なく再開できる形に要約する。\n\n必ず冒頭に「現在の依頼」節を置き、ユーザーが最後に出した未完了の指示を原文のまま引用する。「それ」「実装に進んで」のような指示語で前の発言を指している場合は、指す内容を補い、その一節だけを読めば作業を再開できる自己完結した文にする。未完了の指示が本当に無い場合のみ「現在の依頼: なし」と書く。\n\n続けて次を簡潔に記録する。\n- 完了した作業と、変更したファイルのパス\n- 検証結果(テスト、コマンド出力の要点)\n- 未解決の問題と、次に取るべき手順\n- ユーザーが示した制約と決定事項\n\n事実、観察、推測を区別する。確認していないことを完了として書かない。コード、コマンド、識別子、パス、数値は変えない。日本語で書く。"
    }
  }
}
