{
  "$schema": "https://opencode.ai/config.json",
  "version": 1,
  "model": "ollama/qwen3-coder-next:q4_K_M",
  "small_model": "ollama/qwen3-coder-next:q4_K_M",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "timeout": 600000,
        "chunkTimeout": 300000
      },
      "models": {
        "gemma4:31b": {
          "name": "Gemma 4 31B (96k)",
          "limit": {
            "context": 98304,
            "input": 98304,
            "output": 8192
          }
        },
        "qwen3.8:27b": {
          "name": "Qwen 3.8 27B (64k)",
          "limit": {
            "context": 65536,
            "input": 65536,
            "output": 8192
          }
        },
        "qwen3-coder-next:q4_K_M": {
          "name": "Qwen3 Coder Next 80B Q4_K_M (64k)",
          "limit": {
            "context": 65536,
            "input": 65536,
            "output": 8192
          }
        },
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B Q4_K_M (64k)",
          "limit": {
            "context": 65536,
            "input": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "instructions": [
    "/home/ats030/AGENTS.md",
    "/home/ats030/.config/opencode/japanese-response.md"
  ],
  "skills": {
    "paths": [
      "/home/ats030/ai-workflow/plugins/grill-me/skills",
      "/home/ats030/ai-workflow/plugins/thinking-workflow/skills",
      "/home/ats030/ai-workflow/plugins/hallmark/skills"
    ]
  },
  "plugin": [
    "file:///home/ats030/.config/opencode/plugin/compaction-anchor.mjs"
  ],
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8192,
    "preserve_recent_tokens": 28000,
    "tail_turns": 6
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8000
  },
  "agent": {
    "build": {
      "temperature": 0.2,
      "steps": 30
    },
    "plan": {
      "temperature": 0.1
    },
    "compaction": {
      "temperature": 0.1,
      "prompt": "あなたは会話を要約して、別のコーディングエージェントが作業を中断なく再開できるようにする。\n\nユーザーメッセージで指定されたテンプレートの節構成に厳密に従う。節を足すのは、そこで明示的に要求された場合だけ。\nとりわけ「現在の依頼」節が要求されたときは必ず先頭に置き、ユーザーの発言を原文のまま引用する。自分の計画の要約で置き換えない。\n\n事実、観察、推測を区別する。確認していないことを完了として書かない。\nコード、コマンド、識別子、ファイルパス、URL、数値、エラー文字列は一字も変えない。\n本文は日本語で書く。ただしテンプレートの見出しは指定されたとおりの表記を使う。"
    }
  }
}
